# ============================================================================
# HelloAgents 统一环境变量配置文件
# ============================================================================
# 复制此文件为 .env 并填入你的API密钥
# 系统要求：Python 3.10+ （必需）

# ============================================================================
# 🚀 统一配置格式（推荐）- 框架自动检测provider
# ============================================================================
# 只需配置以下4个通用环境变量，框架会自动识别LLM提供商：

# 模型名称
LLM_MODEL_ID=

# API密钥
LLM_API_KEY=

# 服务地址
LLM_BASE_URL=

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=

# ============================================================================
# 🌐 网络代理配置（重要，改错会连带把大模型调用也弄挂）
# ============================================================================
# 本机开着系统代理（Clash 127.0.0.1:7897）：
#   - qdrant-client 经代理访问 Qdrant Cloud 会 TLS 中断（SSL: UNEXPECTED_EOF_WHILE_READING）
#   - 而 api.deepseek.com 直连会命中一个拒连的 IP，必须走代理
# 所以下面三个变量必须一起设置：
#   ⚠️ urllib.getproxies() 的逻辑是「环境变量里有任何代理项就完全忽略注册表」，
#      只写 NO_PROXY 会让 HTTP(S)_PROXY 一起失效，所有请求变直连（大模型调用随即失败）。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# 本地嵌入模型已缓存，禁止联网校验（避免 HuggingFace 超时）
HF_HUB_OFFLINE=

# ============================================================================
# 🛠️ 工具配置（可选）
# ============================================================================

# Tavily搜索（推荐）- 获取API密钥：https://tavily.com/
# TAVILY_API_KEY=

# SerpApi搜索（备选）- 获取API密钥：https://serpapi.com/
# SERPAPI_API_KEY=

# ================================
# Qdrant 向量数据库配置 - 获取API密钥：https://cloud.qdrant.io/
# ================================
# 使用Qdrant云服务 (推荐)
QDRANT_URL=
QDRANT_API_KEY=

# 或使用本地Qdrant (需要Docker)
# QDRANT_URL=
# QDRANT_API_KEY=

# Qdrant集合配置
QDRANT_COLLECTION=
QDRANT_VECTOR_SIZE=
QDRANT_DISTANCE=
QDRANT_TIMEOUT=

# ================================
# Neo4j 图数据库配置 - 获取API密钥：https://neo4j.com/cloud/aura/
# ================================
# 使用Neo4j Aura云服务 (推荐)
# 注意：本机系统证书库里多了一个自签名根证书，Python 3.13 用系统库校验 neo4j+s:// 会失败
# （SSLCertVerificationError: self-signed certificate in certificate chain），故改用 ssc（自签名证书模式）。
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# 或使用本地Neo4j (需要Docker)
# NEO4J_URI=
# NEO4J_USERNAME=
# NEO4J_PASSWORD=

# Neo4j连接配置
NEO4J_DATABASE=
NEO4J_MAX_CONNECTION_LIFETIME=
NEO4J_MAX_CONNECTION_POOL_SIZE=
NEO4J_CONNECTION_TIMEOUT=

# ==========================
# 嵌入（Embedding）配置示例 - 可从阿里云控制台获取：https://dashscope.aliyun.com/
# ==========================
# - 若为空，dashscope 默认 text-embedding-v3；local 默认 sentence-transformers/all-MiniLM-L6-v2
# ⚠️ 云端 Qdrant 上的集合（hello_agents_vectors / rag_knowledge_base）是 384 维，
#    必须用本地 all-MiniLM-L6-v2（384 维）。dashscope text-embedding-v3 是 1024 维，写入会失败。
# ⚠️ 这三项必须一起改：只改 TYPE 而留着 MODEL_NAME=text-embedding-v3，
#    LocalTransformerEmbedding 会构造失败并被静默回退成 dashscope(1024)，维度又不匹配。
EMBED_MODEL_TYPE=
EMBED_MODEL_NAME=
# 本地嵌入模型不接受下面两个参数，启用 dashscope 时再取消注释
# EMBED_API_KEY=
# EMBED_BASE_URL=